<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AdminDashboardController"
            prefWidth="900"
            prefHeight="600">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Label text="Admin Dashboard" styleClass="title-label"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#logout"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="220" styleClass="side-menu">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Button text="View Guests" onAction="#viewGuests" maxWidth="Infinity"/>
            <Button text="View Rooms" onAction="#viewRooms" maxWidth="Infinity"/>
            <Button text="View Reservations" onAction="#viewReservations" maxWidth="Infinity"/>
            <Button text="View Room Types" onAction="#viewRoomTypes" maxWidth="Infinity"/>
            <Button text="View Amenities" onAction="#viewAmenities" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Add New Room" styleClass="section-label"/>

            <GridPane hgap="10" vgap="10" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label text="Room Number:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="roomNumberField"
                        promptText="Example: 103"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"/>

                <Label text="Room Type:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roomTypeBox"
                        prefWidth="180"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"/>

                <Label text="Available:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <CheckBox fx:id="availableCheckBox"
                        selected="true"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>

                <Button text="Add Room"
                        onAction="#addRoom"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Admin Output" styleClass="section-label"/>

            <TextArea fx:id="outputArea"
                    promptText="Data will appear here..."
                    editable="false"
                    prefHeight="300"/>

            <Label fx:id="statusLabel"
                text=""
                styleClass="status-label"/>
        </VBox>
    </center>

</BorderPane>